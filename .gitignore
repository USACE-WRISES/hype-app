__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
# local HyRiver / aiohttp request cache (dev only; Connect Cloud caches to /tmp)
cache/
*.sqlite
# per-session model scratch (never commit run output) — anchored to the repo root so the
# bundled RAS template's Results/ folder stays committable
/tmp/
/results/
/output/
*.hds
*.cbb
*.mppth
# local reference material (HEC-RAS 2025 install + decompile + template source) —
# 400+ MB of installed software; the app bundles only what it needs (hype_app/data/ras_template,
# bin/ras2025)
/reference/
# local working notes — spec drafts, reference GMS projects (multi-GB installed examples),
# manuscript + IPR material, figure-authoring sources. Never published; every asset the app
# ships lives under hype_app/data instead.
/notes/
# stray engine log from dev runs at the repo root
/mpath7.log
# per-developer Claude Code settings (permissions allowlist); launch.json stays shared
.claude/settings.local.json
# dev-browser desktop data root (recents etc.) — the real shell uses %LOCALAPPDATA%\HYPE
/.dev-data/
# test + coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
